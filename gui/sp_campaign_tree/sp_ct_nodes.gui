# I-30 Campaign Tree — node component types (Phase B/C + visual pass).
# Compact node: icon + title + status (objective/stage family).
# Artwork node: 2:1 illustration band + title/status footer (milestone family).
# Frame: entry_bg_simple + simple_frame (vanilla backgrounds.gui).

types sp_ct_node_types {

	type sp_ct_node_compact = widget {
		size = { 200 52 }
		parentanchor = hcenter
		background = {
			using = entry_bg_simple
		}
		background = {
			using = simple_frame
		}

		button = {
			size = { 100% 100% }
			using = glow_button_border
			using = confirm_button_sound
			using = tooltip_above
			block "node_onclick" {
				onclick = "[GetPlayer.IsValid]"
			}
			block "node_tooltip" {
				tooltip = "sp_ct_node_placeholder_tt"
			}
			widget = {
				size = { 100% 100% }
				block "state_locked_dim" { visible = no }
				background = {
					using = dark_area
					alpha = 0.52
				}
			}
			widget = {
				size = { 100% 100% }
				block "state_active_glow" { visible = no }
				background = {
					texture = "gfx/interface/buttons/default_button_mouseover.dds"
					spriteType = Corneredstretched
					spriteborder = { 0 0 }
					blend_mode = colordodge
					alpha = 0.28
				}
			}
			icon = {
				block "node_selected" { visible = no }
				using = highlighted_square_selection
			}

			widget = {
				size = { 100% 100% }
				alwaystransparent = yes
				flowcontainer = {
					direction = horizontal
					parentanchor = center
					spacing = 8
					margin_left = 10
					margin_right = 10
					icon = {
						size = { 40 20 }
						parentanchor = vcenter
						block "node_icon" {
							texture = "gfx/interface/icons/event_icons/event_default.dds"
						}
					}
					flowcontainer = {
						direction = vertical
						parentanchor = vcenter
						layoutpolicy_horizontal = expanding
						spacing = 1

						textbox = {
							block "node_title" { text = "sp_ct_node_placeholder" }
							autoresize = yes
							align = left|nobaseline
							default_format = "#header"
							using = fontsize_small
							max_width = 132
							elide = right
						}
						textbox = {
							block "state_completed" { visible = no }
							text = "sp_ct_state_completed"
							autoresize = yes
							align = left|nobaseline
							using = fontsize_small
							default_format = "#G"
						}
						textbox = {
							block "state_active" { visible = no }
							text = "sp_ct_state_active"
							autoresize = yes
							align = left|nobaseline
							using = fontsize_small
							default_format = "#Y"
						}
						textbox = {
							block "state_available" { visible = no }
							text = "sp_ct_state_available"
							autoresize = yes
							align = left|nobaseline
							using = fontsize_small
						}
						textbox = {
							block "state_locked" { visible = no }
							text = "sp_ct_state_locked"
							autoresize = yes
							align = left|nobaseline
							using = fontsize_small
							default_format = "#I"
						}
					}
				}
			}

		}
	}

	# Major campaign milestone card — 240×120 artwork (2:1) + 36px footer.
	type sp_ct_node_artwork = widget {
		size = { 240 160 }
		parentanchor = hcenter
		margin_bottom = 4

		background = {
			using = entry_bg_simple
		}
		background = {
			using = simple_frame
		}

		button = {
			size = { 100% 100% }
			using = glow_button_border
			using = confirm_button_sound
			using = tooltip_above
			block "node_onclick" {
				onclick = "[GetPlayer.IsValid]"
			}
			block "node_tooltip" {
				tooltip = "sp_ct_node_placeholder_tt"
			}
			widget = {
				size = { 100% 100% }
				block "state_active_glow" { visible = no }
				background = {
					texture = "gfx/interface/buttons/default_button_mouseover.dds"
					spriteType = Corneredstretched
					spriteborder = { 0 0 }
					blend_mode = colordodge
					alpha = 0.30
				}
			}
			icon = {
				block "node_selected" { visible = no }
				using = highlighted_square_selection
			}

			flowcontainer = {
				direction = vertical
				parentanchor = top|hcenter
				spacing = 0

				widget = {
					size = { 240 120 }
					parentanchor = hcenter
					background = {
						using = dark_area
						alpha = 0.40
					}
					icon = {
						size = { 240 120 }
						parentanchor = center
						block "node_icon" {
							texture = "gfx/interface/icons/event_icons/event_default.dds"
						}
					}
					widget = {
						size = { 100% 100% }
						block "state_locked_dim" { visible = no }
						background = {
							using = dark_area
							alpha = 0.50
						}
					}
				}

				widget = {
					size = { 240 1 }
					background = {
						texture = "gfx/interface/backgrounds/divider_gold.dds"
						spriteType = Corneredstretched
						spriteborder = { 0 0 }
						alpha = 0.68
					}
				}

				widget = {
					size = { 240 39 }
					widget = {
						size = { 100% 2 }
						parentanchor = bottom
						block "node_capstone_accent" { visible = no }
						background = {
							texture = "gfx/interface/backgrounds/divider_gold.dds"
							spriteType = Corneredstretched
							spriteborder = { 0 0 }
							alpha = 0.62
						}
					}
					flowcontainer = {
						direction = horizontal
						parentanchor = center
						margin_left = 10
						margin_right = 10
						spacing = 8

						textbox = {
							block "node_title" { text = "sp_ct_node_placeholder" }
							layoutpolicy_horizontal = expanding
							autoresize = yes
							align = left|vcenter|nobaseline
							default_format = "#title"
							using = fontsize_small
							max_width = 156
							elide = right
						}

						textbox = {
							block "state_completed" { visible = no }
							text = "sp_ct_state_completed"
							parentanchor = vcenter
							autoresize = yes
							align = right|vcenter|nobaseline
							using = fontsize_small
							default_format = "#G"
						}
						textbox = {
							block "state_active" { visible = no }
							text = "sp_ct_state_active"
							parentanchor = vcenter
							autoresize = yes
							align = right|vcenter|nobaseline
							using = fontsize_small
							default_format = "#Y"
						}
						textbox = {
							block "state_available" { visible = no }
							text = "sp_ct_state_available"
							parentanchor = vcenter
							autoresize = yes
							align = right|vcenter|nobaseline
							using = fontsize_small
						}
						textbox = {
							block "state_locked" { visible = no }
							text = "sp_ct_state_locked"
							parentanchor = vcenter
							autoresize = yes
							align = right|vcenter|nobaseline
							using = fontsize_small
							default_format = "#I"
						}
					}
				}
			}
		}
	}
}
