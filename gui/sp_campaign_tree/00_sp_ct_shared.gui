# I-30 Campaign Tree — shared presentation primitives (Phase A + visual pass).
# Types register globally; callers in gui/sp_campaign_tree.gui keep the same type names.

types sp_ct_shared_types {

	# Common trunk vertical connector — strongest lane language.
	type sp_ct_connector_trunk_v = widget {
		size = { 4 12 }
		parentanchor = hcenter
		background = {
			texture = "gfx/interface/backgrounds/divider_gold.dds"
			spriteType = Corneredstretched
			spriteborder = { 0 0 }
			alpha = 0.94
		}
	}

	# Ideology / stage vertical connector — muted brass, path-followable at 1080p.
	type sp_ct_connector_v = widget {
		size = { 3 4 }
		parentanchor = hcenter
		background = {
			texture = "gfx/interface/backgrounds/divider_gold.dds"
			spriteType = Corneredstretched
			spriteborder = { 0 0 }
			alpha = 0.88
		}
	}

	type sp_ct_connector_h = widget {
		size = { 6 3 }
		parentanchor = vcenter
		background = {
			texture = "gfx/interface/backgrounds/divider_gold.dds"
			spriteType = Corneredstretched
			spriteborder = { 0 0 }
			alpha = 0.88
		}
	}

	# Identity fork bar — width matches tree content (992).
	# Tick X = lane centers: 160 / 496 / 832 for 320+16+320+16+320.
	# Center drop is slightly stronger so trunk→fork reads continuous.
	type sp_ct_branch_fork = widget {
		size = { 992 12 }
		parentanchor = hcenter
		widget = {
			size = { 992 4 }
			parentanchor = top|hcenter
			background = {
				texture = "gfx/interface/backgrounds/divider_gold.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				alpha = 0.94
			}
		}
		widget = {
			size = { 3 10 }
			position = { 160 2 }
			background = {
				texture = "gfx/interface/backgrounds/divider_gold.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				alpha = 0.86
			}
		}
		widget = {
			size = { 4 10 }
			position = { 496 2 }
			background = {
				texture = "gfx/interface/backgrounds/divider_gold.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				alpha = 0.94
			}
		}
		widget = {
			size = { 3 10 }
			position = { 832 2 }
			background = {
				texture = "gfx/interface/backgrounds/divider_gold.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				alpha = 0.86
			}
		}
	}

	type sp_ct_insp_section_header = widget {
		size = { 100% 26 }
		margin_top = 8
		margin_bottom = 2
		background = {
			using = default_header_bg_faded
		}
		textbox = {
			block "section_title" { text = "sp_ct_node_placeholder" }
			parentanchor = left|vcenter
			margin_left = 10
			autoresize = yes
			align = left|vcenter|nobaseline
			default_format = "#header"
			using = fontsize_small
		}
	}

	# Requirement / territory row — journal complete-line chrome (entry_bg).
	# Prefer ExecuteTooltip loc as req_label (native $checkbox_ticked$ + live names).
	# Icon blocks kept so older callers' blockoverrides stay valid; they occupy no space.
	type sp_ct_insp_req_row = widget {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		minimumsize = { 460 -1 }

		widget = {
			size = { 0 0 }
			block "req_met_icon" { visible = no }
		}
		widget = {
			size = { 0 0 }
			block "req_fail_icon" { visible = no }
		}
		textbox = {
			block "req_label" { text = "sp_ct_node_placeholder" }
			block "req_tooltip" {}
			autoresize = yes
			multiline = yes
			min_width = 460
			max_width = 460
			using = default_list_position
			align = nobaseline
			margin = { 15 8 }
			background = {
				using = entry_bg
			}
		}
	}

	type sp_ct_insp_divider = widget {
		size = { 100% 2 }
		margin_top = 8
		margin_bottom = 4
		divider_gold = {}
	}

	type sp_ct_insp_stat_row = widget {
		size = { 100% 28 }
		layoutpolicy_horizontal = expanding
		icon = {
			size = { 20 20 }
			parentanchor = left|vcenter
			position = { 8 0 }
			block "stat_icon" {
				texture = "gfx/interface/icons/generic_icons/prestige.dds"
			}
		}
		textbox = {
			block "stat_label" { text = "sp_ct_node_placeholder" }
			parentanchor = left|vcenter
			position = { 36 0 }
			autoresize = yes
			align = left|vcenter|nobaseline
			using = fontsize_small
			maximumsize = { 300 -1 }
			elide = right
		}
		textbox = {
			block "stat_value" { text = "sp_ct_node_placeholder" }
			parentanchor = right|vcenter
			position = { -10 0 }
			autoresize = yes
			align = right|vcenter|nobaseline
			using = fontsize_small
			default_format = "#v"
		}
	}

	# Live progress meter — Turan stage bindings (I-28 presentation only).
	type sp_ct_insp_progress_turan_live = widget {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		visible = "[And(GetPlayer.MakeScope.Var('sp_turan_stage_progress').IsSet, GetPlayer.MakeScope.Var('sp_turan_stage_goal').IsSet)]"
		sp_ct_insp_progress_card = {}
	}

	# Live progress meter — Islamism stage bindings.
	type sp_ct_insp_progress_islamism_live = widget {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		visible = "[And(GetPlayer.MakeScope.Var('sp_islamism_stage_progress').IsSet, GetPlayer.MakeScope.Var('sp_islamism_stage_goal').IsSet)]"
		background = {
			using = entry_bg_simple
		}
		flowcontainer = {
			direction = vertical
			spacing = 6
			margin = { 10 10 }
			margin_bottom = 12
			widget = {
				size = { 100% 22 }
				textbox = {
					text = "sp_ct_progress_controlled"
					parentanchor = left|vcenter
					autoresize = yes
					align = left|vcenter|nobaseline
					using = fontsize_small
					default_format = "#title"
				}
				textbox = {
					raw_text = "[GetPlayer.MakeScope.Var('sp_islamism_stage_progress').GetValue|0] / [GetPlayer.MakeScope.Var('sp_islamism_stage_goal').GetValue|0]"
					parentanchor = right|vcenter
					autoresize = yes
					align = right|vcenter|nobaseline
					using = fontsize_small
					default_format = "#Y"
				}
			}
			default_progressbar_horizontal = {
				size = { 100% 26 }
				blockoverride "values" {
					value = "[GetPlayer.MakeScope.Var('sp_islamism_stage_progress').GetValue]"
					min = 0
					max = "[GetPlayer.MakeScope.Var('sp_islamism_stage_goal').GetValue]"
				}
			}
		}
	}

	type sp_ct_insp_progress_card = widget {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		background = {
			using = entry_bg_simple
		}
		flowcontainer = {
			direction = vertical
			spacing = 6
			margin = { 10 10 }
			margin_bottom = 12

			widget = {
				size = { 100% 22 }
				textbox = {
					block "progress_label" { text = "sp_ct_progress_controlled" }
					parentanchor = left|vcenter
					autoresize = yes
					align = left|vcenter|nobaseline
					using = fontsize_small
					default_format = "#title"
				}
				textbox = {
					block "progress_value_raw" {
						raw_text = "[GetPlayer.MakeScope.Var('sp_turan_stage_progress').GetValue|0] / [GetPlayer.MakeScope.Var('sp_turan_stage_goal').GetValue|0]"
					}
					parentanchor = right|vcenter
					autoresize = yes
					align = right|vcenter|nobaseline
					using = fontsize_small
					default_format = "#Y"
				}
			}

			default_progressbar_horizontal = {
				size = { 100% 26 }
				blockoverride "values" {
					value = "[GetPlayer.MakeScope.Var('sp_turan_stage_progress').GetValue]"
					min = 0
					max = "[GetPlayer.MakeScope.Var('sp_turan_stage_goal').GetValue]"
				}
			}

			block "progress_card_content" {}
		}
	}

	# Native JE reason chrome — copied from journal_entry.gui GetReason textbox
	# (entry_bg + default_list_position + 15px margin). Inspector width is 460, not
	# vanilla @panel_width_minus_30 (510). Override reason_text with the JE loc key
	# (same string JournalEntry.GetReason shows for static reasons).
	type sp_ct_insp_reason_box = textbox {
		block "reason_text" { text = "sp_ct_node_placeholder" }
		autoresize = yes
		min_width = 460
		max_width = 460
		multiline = yes
		using = default_list_position
		align = nobaseline
		margin = { 15 15 }
		background = {
			using = entry_bg
		}
	}

	# Native JE body — journal_entry.gui GetStatusDesc / progress / complete_text / fail_text.
	type sp_ct_insp_je_status_lines = flowcontainer {
		direction = vertical
		spacing = 5
		textbox = {
			visible = "[Not(StringIsEmpty(JournalEntry.GetStatusDesc))]"
			text = "[JournalEntry.GetStatusDesc]"
			autoresize = yes
			multiline = yes
			minimumsize = { 460 -1 }
			maximumsize = { 460 -1 }
			using = default_list_position
			align = hcenter|nobaseline
			using = fontsize_large
			margin = { 20 20 }
			background = {
				alpha = 0.5
				using = entry_bg_fancy_dark
			}
		}
		textbox = {
			visible = "[Not(StringIsEmpty(JournalEntry.GetProgressDesc))]"
			text = "[JournalEntry.GetProgressDesc]"
			autoresize = yes
			multiline = yes
			minimumsize = { 460 -1 }
			maximumsize = { 460 -1 }
			using = default_list_position
			align = nobaseline
			margin = { 15 0 }
			background = {
				using = entry_bg
			}
		}
		flowcontainer = {
			visible = "[And(JournalEntry.HasProgressBar, JournalEntry.IsActive)]"
			direction = vertical
			margin = { 0 8 }
			default_progressbar_horizontal = {
				size = { 460 26 }
				blockoverride "values" {
					value = "[FixedPointToFloat(JournalEntry.GetGoalProgressPercent)]"
					min = 0
					max = 1
				}
			}
		}
		textbox = {
			visible = "[JournalEntry.CanComplete]"
			text = "[JournalEntry.GetCompletionTooltip]"
			autoresize = yes
			multiline = yes
			minimumsize = { 460 -1 }
			maximumsize = { 460 -1 }
			using = default_list_position
			align = nobaseline
			margin = { 15 5 }
			background = {
				texture = "gfx/interface/tooltip/tooltip_title_bg.dds"
				using = color_gold_positive
				alpha = 0.4
				modify_texture = {
					using = texture_velvet
				}
			}
		}
		textbox = {
			visible = "[Not(StringIsEmpty(JournalEntry.GetOnCompleteTooltip))]"
			text = "[JournalEntry.GetOnCompleteTooltip]"
			autoresize = yes
			multiline = yes
			minimumsize = { 460 -1 }
			maximumsize = { 460 -1 }
			using = default_list_position
			align = nobaseline
			margin_left = 35
			margin_right = 15
		}
		textbox = {
			visible = "[Not(StringIsEmpty(JournalEntry.GetFailureTooltip))]"
			text = "[JournalEntry.GetFailureTooltip]"
			autoresize = yes
			multiline = yes
			minimumsize = { 460 -1 }
			maximumsize = { 460 -1 }
			using = default_list_position
			align = nobaseline
			margin = { 15 5 }
			background = {
				texture = "gfx/interface/tooltip/tooltip_title_bg.dds"
				using = color_blue_negative
				alpha = 0.5
				modify_texture = {
					using = texture_velvet
				}
			}
		}
		textbox = {
			visible = "[Not(StringIsEmpty(JournalEntry.GetOnFailTooltip))]"
			text = "[JournalEntry.GetOnFailTooltip]"
			autoresize = yes
			multiline = yes
			minimumsize = { 460 -1 }
			maximumsize = { 460 -1 }
			using = default_list_position
			align = nobaseline
			margin_left = 35
			margin_right = 15
		}
		textbox = {
			visible = "[Not(StringIsEmpty(JournalEntry.GetOnTimeoutTooltip))]"
			text = "[JournalEntry.GetOnTimeoutTooltip]"
			autoresize = yes
			multiline = yes
			minimumsize = { 460 -1 }
			maximumsize = { 460 -1 }
			using = default_list_position
			align = nobaseline
			margin_left = 35
			margin_right = 15
		}
	}

	# Open / Pin / Unpin — expects JournalEntry datacontext.
	type sp_ct_insp_je_action_buttons = flowcontainer {
		direction = horizontal
		spacing = 8
		button = {
			size = { 184 32 }
			using = default_button_action
			using = confirm_button_sound
			visible = "[JournalEntry.IsValid]"
			enabled = "[JournalEntry.IsValid]"
			onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
			onclick = "[GetVariableSystem.Clear('com_fullscreen')]"
			onclick = "[GetVariableSystem.Clear('com_open_window')]"
			tooltip = "sp_ct_btn_open_je_tt"
			textbox = {
				parentanchor = center
				text = "sp_ct_btn_open_je"
				autoresize = yes
				align = hcenter|nobaseline
				using = fontsize_small
			}
		}
		button = {
			size = { 132 32 }
			using = default_button_action
			using = check_button_sound
			visible = "[And(JournalEntry.IsValid, Not(JournalEntry.IsPinnedInOutliner))]"
			enabled = "[JournalEntry.IsValid]"
			onclick = "[JournalEntry.TogglePinInOutliner]"
			tooltip = "PIN_JOURNAL_ENTRY"
			textbox = {
				parentanchor = center
				text = "sp_ct_btn_pin_je"
				autoresize = yes
				align = hcenter|nobaseline
				using = fontsize_small
			}
		}
		button = {
			size = { 132 32 }
			using = default_button_action
			using = check_button_sound
			visible = "[And(JournalEntry.IsValid, JournalEntry.IsPinnedInOutliner)]"
			enabled = "[JournalEntry.IsValid]"
			onclick = "[JournalEntry.TogglePinInOutliner]"
			tooltip = "UNPIN_JOURNAL_ENTRY"
			textbox = {
				parentanchor = center
				text = "sp_ct_btn_unpin_je"
				autoresize = yes
				align = hcenter|nobaseline
				using = fontsize_small
			}
		}
	}

	# Find JE by type name in active, then inactive groups (vanilla journal.gui both tabs).
	type sp_ct_insp_je_typed_status = flowcontainer {
		direction = vertical
		flowcontainer = {
			direction = vertical
			datamodel = "[AccessPlayer.GetGroupsForActiveJournalEntries]"
			item = {
				flowcontainer = {
					direction = vertical
					datamodel = "[JournalEntryGroup.GetActiveJournalEntryTypes(GetPlayer.Self)]"
					item = {
						flowcontainer = {
							direction = vertical
							spacing = 6
							block "je_type_visible" { visible = no }
							datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
							sp_ct_insp_je_status_lines = {}
						}
					}
				}
			}
		}
		flowcontainer = {
			direction = vertical
			datamodel = "[AccessPlayer.GetGroupsForInActiveJournalEntries]"
			item = {
				flowcontainer = {
					direction = vertical
					datamodel = "[JournalEntryGroup.GetInactiveJournalEntryTypes(GetPlayer.Self)]"
					item = {
						flowcontainer = {
							direction = vertical
							spacing = 6
							block "je_type_visible" { visible = no }
							datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
							sp_ct_insp_je_status_lines = {}
						}
					}
				}
			}
		}
	}

	type sp_ct_insp_je_typed_actions = flowcontainer {
		direction = vertical
		datamodel = "[AccessPlayer.GetGroupsForActiveJournalEntries]"
		item = {
			flowcontainer = {
				direction = vertical
				datamodel = "[JournalEntryGroup.GetActiveJournalEntryTypes(GetPlayer.Self)]"
				item = {
					flowcontainer = {
						direction = vertical
						block "je_type_visible" { visible = no }
						datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
						sp_ct_insp_je_action_buttons = {}
					}
				}
			}
		}
	}

	# Thin JE bindings — only override the type-name visibility filter.
	type sp_ct_insp_je_turan_status = sp_ct_insp_je_typed_status {
		blockoverride "je_type_visible" {
			visible = "[EqualTo_string(JournalEntryType.GetName, Localize('sp_je_turanian_ideal'))]"
		}
	}
	type sp_ct_insp_je_turan_actions = sp_ct_insp_je_typed_actions {
		blockoverride "je_type_visible" {
			visible = "[EqualTo_string(JournalEntryType.GetName, Localize('sp_je_turanian_ideal'))]"
		}
	}
	type sp_ct_insp_je_post_tanzimat_status = sp_ct_insp_je_typed_status {
		blockoverride "je_type_visible" {
			visible = "[EqualTo_string(JournalEntryType.GetName, Localize('sp_je_post_tanzimat_era'))]"
		}
	}
	type sp_ct_insp_je_post_tanzimat_actions = sp_ct_insp_je_typed_actions {
		blockoverride "je_type_visible" {
			visible = "[EqualTo_string(JournalEntryType.GetName, Localize('sp_je_post_tanzimat_era'))]"
		}
	}
	type sp_ct_insp_je_ottomanism_status = sp_ct_insp_je_typed_status {
		blockoverride "je_type_visible" {
			visible = "[EqualTo_string(JournalEntryType.GetName, Localize('sp_je_ottomanism'))]"
		}
	}
	type sp_ct_insp_je_ottomanism_actions = sp_ct_insp_je_typed_actions {
		blockoverride "je_type_visible" {
			visible = "[EqualTo_string(JournalEntryType.GetName, Localize('sp_je_ottomanism'))]"
		}
	}
	type sp_ct_insp_je_islamism_status = sp_ct_insp_je_typed_status {
		blockoverride "je_type_visible" {
			visible = "[EqualTo_string(JournalEntryType.GetName, Localize('sp_je_pan_islamic_unity'))]"
		}
	}
	type sp_ct_insp_je_islamism_actions = sp_ct_insp_je_typed_actions {
		blockoverride "je_type_visible" {
			visible = "[EqualTo_string(JournalEntryType.GetName, Localize('sp_je_pan_islamic_unity'))]"
		}
	}

	# Sick Man uses objective JE list (not JournalEntryGroup).
	type sp_ct_insp_je_sick_man_actions = flowcontainer {
		direction = vertical
		datamodel = "[AccessPlayer.AccessActivePlayerObjectiveJournalEntries]"
		item = {
			flowcontainer = {
				direction = vertical
				visible = "[EqualTo_string(JournalEntry.GetName, Localize('je_sick_man_main'))]"
				sp_ct_insp_je_action_buttons = {}
			}
		}
	}

	type sp_ct_insp_je_sick_man_status = flowcontainer {
		direction = vertical
		datamodel = "[AccessPlayer.AccessActivePlayerObjectiveJournalEntries]"
		item = {
			flowcontainer = {
				direction = vertical
				spacing = 6
				visible = "[EqualTo_string(JournalEntry.GetName, Localize('je_sick_man_main'))]"
				sp_ct_insp_je_status_lines = {}
			}
		}
	}

	# Objective sub-JEs — journal complete_text chrome (GetName / GetCompletionTooltip / GetOnCompleteTooltip).
	type sp_ct_insp_je_sick_man_objectives_status = flowcontainer {
		direction = vertical
		datamodel = "[AccessPlayer.AccessActivePlayerObjectiveJournalEntries]"
		item = {
			flowcontainer = {
				direction = vertical
				spacing = 5
				margin_bottom = 8
				visible = "[Not(EqualTo_string(JournalEntry.GetName, Localize('je_sick_man_main')))]"
				textbox = {
					text = "[JournalEntry.GetName]"
					autoresize = yes
					align = left|nobaseline
					default_format = "#header"
					using = default_list_position
					minimumsize = { 460 -1 }
					maximumsize = { 460 -1 }
					multiline = yes
					margin = { 15 8 }
					background = {
						using = entry_bg
					}
				}
				textbox = {
					visible = "[Not(StringIsEmpty(JournalEntry.GetCompletionTooltip))]"
					text = "[JournalEntry.GetCompletionTooltip]"
					autoresize = yes
					multiline = yes
					minimumsize = { 460 -1 }
					maximumsize = { 460 -1 }
					using = default_list_position
					align = nobaseline
					margin = { 15 5 }
					background = {
						texture = "gfx/interface/tooltip/tooltip_title_bg.dds"
						using = color_gold_positive
						alpha = 0.4
						modify_texture = {
							using = texture_velvet
						}
					}
				}
				textbox = {
					visible = "[Not(StringIsEmpty(JournalEntry.GetOnCompleteTooltip))]"
					text = "[JournalEntry.GetOnCompleteTooltip]"
					autoresize = yes
					multiline = yes
					minimumsize = { 460 -1 }
					maximumsize = { 460 -1 }
					using = default_list_position
					align = nobaseline
					margin_left = 35
					margin_right = 15
				}
			}
		}
	}
}
