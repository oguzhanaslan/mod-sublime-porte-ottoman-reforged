# I-30 Campaign Tree — shared presentation primitives (Phase A + visual pass).
# Types register globally; callers in gui/sp_campaign_tree.gui keep the same type names.

types sp_ct_shared_types {

	# Common trunk vertical connector — strongest lane language.
	type sp_ct_connector_trunk_v = widget {
		size = { 4 12 }
		parentanchor = hcenter
		background = {
			texture = "gfx/interface/backgrounds/divider_gold.dds"
			spriteType = Corneredstretched
			spriteborder = { 0 0 }
			alpha = 0.92
		}
	}

	# Ideology / stage vertical connector — shorter gaps for taller mini cards.
	type sp_ct_connector_v = widget {
		size = { 3 4 }
		parentanchor = hcenter
		background = {
			texture = "gfx/interface/backgrounds/divider_gold.dds"
			spriteType = Corneredstretched
			spriteborder = { 0 0 }
			alpha = 0.78
		}
	}

	type sp_ct_connector_h = widget {
		size = { 6 3 }
		parentanchor = vcenter
		background = {
			texture = "gfx/interface/backgrounds/divider_gold.dds"
			spriteType = Corneredstretched
			spriteborder = { 0 0 }
			alpha = 0.78
		}
	}

	# Identity fork bar — width matches tree content (992).
	# Tick X = lane centers: 160 / 496 / 832 for 320+16+320+16+320.
	# Center drop is slightly stronger so trunk→fork reads continuous.
	type sp_ct_branch_fork = widget {
		size = { 992 12 }
		parentanchor = hcenter
		widget = {
			size = { 992 4 }
			parentanchor = top|hcenter
			background = {
				texture = "gfx/interface/backgrounds/divider_gold.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				alpha = 0.92
			}
		}
		widget = {
			size = { 3 10 }
			position = { 160 2 }
			background = {
				texture = "gfx/interface/backgrounds/divider_gold.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				alpha = 0.78
			}
		}
		widget = {
			size = { 4 10 }
			position = { 496 2 }
			background = {
				texture = "gfx/interface/backgrounds/divider_gold.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				alpha = 0.90
			}
		}
		widget = {
			size = { 3 10 }
			position = { 832 2 }
			background = {
				texture = "gfx/interface/backgrounds/divider_gold.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				alpha = 0.78
			}
		}
	}

	type sp_ct_insp_section_header = widget {
		size = { 100% 26 }
		margin_top = 8
		margin_bottom = 2
		background = {
			using = default_header_bg_faded
		}
		textbox = {
			block "section_title" { text = "sp_ct_node_placeholder" }
			parentanchor = left|vcenter
			margin_left = 10
			autoresize = yes
			align = left|vcenter|nobaseline
			default_format = "#title"
			using = fontsize_small
		}
	}

	# Requirement / territory row — icon communicates met/fail; no separate status text.
	# Callers override req_met_icon / req_fail_icon visibility only (block contract preserved).
	type sp_ct_insp_req_row = widget {
		size = { 100% 28 }
		layoutpolicy_horizontal = expanding

		# Shared icon slot (met and fail occupy the same bounds; never both visible).
		widget = {
			size = { 20 28 }
			parentanchor = left|vcenter
			position = { 8 0 }
			block "req_met_icon" { visible = no }
			icon = {
				size = { 16 16 }
				parentanchor = center
				texture = "gfx/interface/icons/generic_icons/green_checkmark.dds"
			}
		}
		widget = {
			size = { 20 28 }
			parentanchor = left|vcenter
			position = { 8 0 }
			block "req_fail_icon" { visible = no }
			icon = {
				size = { 16 16 }
				parentanchor = center
				texture = "gfx/interface/icons/generic_icons/red_cross.dds"
			}
		}
		textbox = {
			block "req_label" { text = "sp_ct_node_placeholder" }
			block "req_tooltip" {}
			parentanchor = left|vcenter
			position = { 36 0 }
			autoresize = yes
			align = left|vcenter|nobaseline
			using = fontsize_small
			maximumsize = { 420 -1 }
			elide = right
		}
	}

	type sp_ct_insp_divider = widget {
		size = { 100% 2 }
		margin_top = 8
		margin_bottom = 4
		divider_gold = {}
	}

	type sp_ct_insp_stat_row = widget {
		size = { 100% 28 }
		layoutpolicy_horizontal = expanding
		icon = {
			size = { 20 20 }
			parentanchor = left|vcenter
			position = { 8 0 }
			block "stat_icon" {
				texture = "gfx/interface/icons/generic_icons/prestige.dds"
			}
		}
		textbox = {
			block "stat_label" { text = "sp_ct_node_placeholder" }
			parentanchor = left|vcenter
			position = { 36 0 }
			autoresize = yes
			align = left|vcenter|nobaseline
			using = fontsize_small
			maximumsize = { 300 -1 }
			elide = right
		}
		textbox = {
			block "stat_value" { text = "sp_ct_node_placeholder" }
			parentanchor = right|vcenter
			position = { -10 0 }
			autoresize = yes
			align = right|vcenter|nobaseline
			using = fontsize_small
			default_format = "#v"
		}
	}

	# Live progress meter — Turan stage bindings (I-28 presentation only).
	type sp_ct_insp_progress_turan_live = widget {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		visible = "[And(GetPlayer.MakeScope.Var('sp_turan_stage_progress').IsSet, GetPlayer.MakeScope.Var('sp_turan_stage_goal').IsSet)]"
		sp_ct_insp_progress_card = {}
	}

	# Live progress meter — Islamism stage bindings.
	type sp_ct_insp_progress_islamism_live = widget {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		visible = "[And(GetPlayer.MakeScope.Var('sp_islamism_stage_progress').IsSet, GetPlayer.MakeScope.Var('sp_islamism_stage_goal').IsSet)]"
		background = {
			using = entry_bg_simple
		}
		flowcontainer = {
			direction = vertical
			spacing = 6
			margin = { 10 10 }
			margin_bottom = 12
			widget = {
				size = { 100% 22 }
				textbox = {
					text = "sp_ct_progress_controlled"
					parentanchor = left|vcenter
					autoresize = yes
					align = left|vcenter|nobaseline
					using = fontsize_small
					default_format = "#title"
				}
				textbox = {
					raw_text = "[GetPlayer.MakeScope.Var('sp_islamism_stage_progress').GetValue|0] / [GetPlayer.MakeScope.Var('sp_islamism_stage_goal').GetValue|0]"
					parentanchor = right|vcenter
					autoresize = yes
					align = right|vcenter|nobaseline
					using = fontsize_small
					default_format = "#Y"
				}
			}
			default_progressbar_horizontal = {
				size = { 100% 26 }
				blockoverride "values" {
					value = "[GetPlayer.MakeScope.Var('sp_islamism_stage_progress').GetValue]"
					min = 0
					max = "[GetPlayer.MakeScope.Var('sp_islamism_stage_goal').GetValue]"
				}
			}
		}
	}

	type sp_ct_insp_progress_card = widget {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		background = {
			using = entry_bg_simple
		}
		flowcontainer = {
			direction = vertical
			spacing = 6
			margin = { 10 10 }
			margin_bottom = 12

			widget = {
				size = { 100% 22 }
				textbox = {
					block "progress_label" { text = "sp_ct_progress_controlled" }
					parentanchor = left|vcenter
					autoresize = yes
					align = left|vcenter|nobaseline
					using = fontsize_small
					default_format = "#title"
				}
				textbox = {
					block "progress_value_raw" {
						raw_text = "[GetPlayer.MakeScope.Var('sp_turan_stage_progress').GetValue|0] / [GetPlayer.MakeScope.Var('sp_turan_stage_goal').GetValue|0]"
					}
					parentanchor = right|vcenter
					autoresize = yes
					align = right|vcenter|nobaseline
					using = fontsize_small
					default_format = "#Y"
				}
			}

			default_progressbar_horizontal = {
				size = { 100% 26 }
				blockoverride "values" {
					value = "[GetPlayer.MakeScope.Var('sp_turan_stage_progress').GetValue]"
					min = 0
					max = "[GetPlayer.MakeScope.Var('sp_turan_stage_goal').GetValue]"
				}
			}

			block "progress_card_content" {}
		}
	}
}
