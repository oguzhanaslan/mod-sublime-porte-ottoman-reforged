# I-30 Campaign Tree — native fullscreen header (Phase F + runtime fix).
# Structural source: Victoria 3 1.13.11 block_windows.gui (L376–424 centered title +
# overlay back/close). Presentation only; onclick blocks overridden from sp_campaign_tree_window.

types sp_ct_header_types {

	type sp_ct_campaign_header = widget {
		size = { 0 70 }
		layoutpolicy_horizontal = expanding

		textbox = {
			parentanchor = center
			size = { 100% 50 }
			maximumsize = { -1 50 }
			fontsize_min = 14
			using = header_font_fancy
			using = header_font_fancy_size
			text = "sp_ct_window_title"
			default_format = "#header"
			align = hcenter|vcenter|nobaseline
			autoresize = yes
		}

		block "header_back_button" {
			back_button_large = {
				position = { 11 11 }
				parentanchor = top|left
				onclick = "[GetPlayer.IsValid]"
				input_action = "back"
			}
		}

		block "header_close_button" {
			close_button_large = {
				parentanchor = top|right
				position = { -11 11 }
				onclick = "[GetPlayer.IsValid]"
				shortcut = "close_window"
			}
		}
	}
}
