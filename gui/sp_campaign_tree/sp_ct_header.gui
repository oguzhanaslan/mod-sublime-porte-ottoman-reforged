# I-30 Campaign Tree — native fullscreen header (Phase F + visual pass).
# Structural source: Victoria 3 1.13.11 block_windows.gui fullscreen_block_window
# header row (L868–914): 70px band, back top|left {11 15}, close top|right {-11 15},
# title hbox margin {250 0} for side-control clearance.
# Presentation only; onclick blocks are overridden from sp_campaign_tree_window.

types sp_ct_header_types {

	type sp_ct_campaign_header = widget {
		size = { 0 70 }
		layoutpolicy_horizontal = expanding

		block "header_back_button" {
			back_button_large = {
				position = { 11 15 }
				parentanchor = top|left
				onclick = "[GetPlayer.IsValid]"
				input_action = "back"
			}
		}

		block "header_close_button" {
			close_button_large = {
				parentanchor = top|right
				position = { -11 15 }
				onclick = "[GetPlayer.IsValid]"
				shortcut = "close_window"
			}
		}

		hbox = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			margin = { 250 0 }
			margin_bottom = 4

			hbox = {
				parentanchor = center
				spacing = 12

				icon = {
					size = { 48 48 }
					parentanchor = vcenter
					texture = "gfx/interface/icons/sp_campaign_tree/sp_ct_header_logo.dds"
				}
				textbox = {
					text = "sp_ct_window_title"
					autoresize = yes
					parentanchor = vcenter
					align = left|vcenter|nobaseline
					default_format = "#header"
					using = header_font_fancy
					using = header_font_fancy_size
				}
			}
		}
	}
}
