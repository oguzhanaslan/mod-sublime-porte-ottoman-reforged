	# Phase D2A — Islamism path hub.
	type sp_ct_inspector_islamism = widget {
		size = { 100% -1 }
		layoutpolicy_vertical = expanding
		layoutpolicy_horizontal = expanding
		minimumsize = { 500 -1 }

		vbox = {
			size = { 100% 100% }
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			spacing = 8

			sp_ct_insp_artwork_band = {
				blockoverride "artwork_texture" {
					texture = "gfx/interface/illustrations/sp_campaign_tree/sp_ct_insp_islamism.dds"
				}
			}

			sp_ct_insp_status_header = {
				blockoverride "insp_title" { text = "sp_ct_node_islamism" }
				blockoverride "insp_status_completed" { visible = "[GetScriptedGui('sp_ct_vis_islamism_completed').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "insp_status_active" { visible = "[GetScriptedGui('sp_ct_vis_islamism_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "insp_status_available" { visible = "[GetScriptedGui('sp_ct_vis_islamism_available').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "insp_status_locked" { visible = "[GetScriptedGui('sp_ct_vis_islamism_locked').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
			}

			widget = {
				size = { 100% -1 }
				layoutpolicy_vertical = preferred
				layoutpolicy_horizontal = expanding
				minimumsize = { 480 -1 }
				flowcontainer = {
					direction = vertical
					spacing = 4
					textbox = {
						text = "sp_ct_sec_description"
						autoresize = yes
						align = left|nobaseline
						default_format = "#title"
						using = fontsize_small
					}
					textbox = {
						text = "sp_ct_insp_islamism_desc"
						autoresize = yes
						align = left|nobaseline
						using = fontsize_small
						max_width = 500
						multiline = yes
					}
					textbox = {
						text = "sp_ct_sec_flavor"
						autoresize = yes
						align = left|nobaseline
						default_format = "#title"
						using = fontsize_small
						margin_top = 4
					}
					textbox = {
						text = "sp_ct_insp_islamism_flavor"
						autoresize = yes
						align = left|nobaseline
						using = fontsize_small
						max_width = 500
						multiline = yes
					}
				}
			}

			sp_ct_insp_scroll_panel = {
				blockoverride "scroll_content" {
					flowcontainer = {
						direction = vertical
						spacing = 8
						minimumsize = { 500 -1 }

						sp_ct_insp_section_panel = {
							blockoverride "section_title" { text = "sp_ct_sec_unlock" }
							blockoverride "section_body" {
								sp_ct_insp_req_row = {
									blockoverride "req_met_icon" { visible = "[GetScriptedGui('sp_ct_vis_req_post_tanzimat_gate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
									blockoverride "req_fail_icon" { visible = "[Not(GetScriptedGui('sp_ct_vis_req_post_tanzimat_gate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
									blockoverride "req_label" { text = "sp_ct_req_post_tanzimat_gate" }
									blockoverride "req_tooltip" { tooltip = "sp_ct_req_post_tanzimat_gate_tt" }
								}
							}
						}

						sp_ct_insp_section_panel = {
							blockoverride "section_title" { text = "sp_ct_sec_completion" }
							blockoverride "section_body" {
								sp_ct_insp_req_row = {
									blockoverride "req_met_icon" { visible = "[GetScriptedGui('sp_ct_vis_req_islamism').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
									blockoverride "req_fail_icon" { visible = "[Not(GetScriptedGui('sp_ct_vis_req_islamism').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
									blockoverride "req_label" { text = "sp_ct_req_path_islamism" }
