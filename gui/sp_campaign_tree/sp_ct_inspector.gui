							blockoverride "section_body" {
								textbox = {
									text = "sp_ct_insp_ottomanism_rewards"
									tooltip = "sp_ct_insp_ottomanism_rewards_tt"
									autoresize = yes
									align = left|nobaseline
									using = fontsize_small
									max_width = 480
									multiline = yes
								}
							}
						}

						sp_ct_insp_section_panel = {
							blockoverride "section_title" { text = "sp_ct_sec_navigation" }
							blockoverride "section_body" {
								textbox = {
									text = "sp_ct_nav_prev_identity"
									autoresize = yes
									align = left|nobaseline
									using = fontsize_small
									max_width = 480
									multiline = yes
