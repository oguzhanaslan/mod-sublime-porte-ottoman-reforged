									blockoverride "req_met_icon" { visible = "[GetScriptedGui('sp_ct_vis_req_pan_nationalism').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
									blockoverride "req_fail_icon" { visible = "[Not(GetScriptedGui('sp_ct_vis_req_pan_nationalism').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
									blockoverride "req_label" { text = "sp_ct_req_pan_nationalism" }
									blockoverride "req_tooltip" { tooltip = "sp_ct_req_pan_nationalism_tt" }
								}
								sp_ct_insp_req_row = {
									blockoverride "req_met_icon" { visible = "[GetScriptedGui('sp_ct_vis_req_post_tanzimat_gate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
									blockoverride "req_fail_icon" { visible = "[Not(GetScriptedGui('sp_ct_vis_req_post_tanzimat_gate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
									blockoverride "req_label" { text = "sp_ct_req_post_tanzimat_gate" }
									blockoverride "req_tooltip" { tooltip = "sp_ct_req_post_tanzimat_gate_tt" }
								}
							}
						}

						sp_ct_insp_section_panel = {
							visible = "[Or(GetPlayer.MakeScope.Var('sp_turan_stage').IsSet, And(GetPlayer.MakeScope.Var('sp_turan_stage_progress').IsSet, GetPlayer.MakeScope.Var('sp_turan_stage_goal').IsSet))]"
							blockoverride "section_title" { text = "sp_ct_sec_progress" }
							blockoverride "section_body" {
								flowcontainer = {
									direction = horizontal
									spacing = 4
									visible = "[GetPlayer.MakeScope.Var('sp_turan_stage').IsSet]"
									textbox = {
										text = "sp_ct_progress_stage"
										autoresize = yes
										align = left|nobaseline
										using = fontsize_medium
									}
									textbox = {
										raw_text = "[GetPlayer.MakeScope.Var('sp_turan_stage').GetValue|0]"
										autoresize = yes
										align = left|nobaseline
										using = fontsize_medium
									}
								}
								sp_ct_insp_progress_turan_live = {}
