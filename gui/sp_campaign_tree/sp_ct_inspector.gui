									blockoverride "req_tooltip" { tooltip = "sp_ct_req_turan_ideal_complete_tt" }
								}
							}
						}

						sp_ct_insp_section_panel = {
							blockoverride "section_title" { text = "sp_ct_sec_rewards" }
							blockoverride "section_body" {
								textbox = {
									text = "sp_ct_insp_turan_rewards"
									tooltip = "sp_ct_insp_turan_rewards_tt"
									autoresize = yes
									align = left|nobaseline
									using = fontsize_small
									max_width = 480
									multiline = yes
									margin_bottom = 4
								}
								sp_ct_insp_stat_row = {
									blockoverride "stat_icon" { texture = "gfx/interface/icons/generic_icons/prestige.dds" }
									blockoverride "stat_label" { text = "sp_ct_reward_prestige" }
									blockoverride "stat_value" { text = "sp_ct_reward_prestige_10_val" }
								}
								sp_ct_insp_stat_row = {
									blockoverride "stat_icon" { texture = "gfx/interface/icons/timed_modifier_icons/modifier_statue_positive.dds" }
									blockoverride "stat_label" { text = "sp_ct_reward_modifier" }
									blockoverride "stat_value" { text = "sp_ct_reward_modifier_unifier_val" }
								}
							}
						}

						sp_ct_insp_section_panel = {
							blockoverride "section_title" { text = "sp_ct_sec_navigation" }
							blockoverride "section_body" {
								textbox = {
									text = "sp_ct_nav_prev_turkism"
									autoresize = yes
									align = left|nobaseline
									using = fontsize_small
									max_width = 480
									multiline = yes
								}
								textbox = {
									text = "sp_ct_nav_next_turan_s1"
									autoresize = yes
									align = left|nobaseline
									using = fontsize_small
									max_width = 480
									multiline = yes
								}
							}
						}

						sp_ct_insp_section_panel = {
							visible = "[GetScriptedGui('sp_ct_vis_req_je_turan').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							blockoverride "section_title" { text = "sp_ct_sec_actions" }
							blockoverride "section_body" {
								flowcontainer = {
									direction = horizontal
									spacing = 8
									flowcontainer = {
										direction = vertical
										datamodel = "[AccessPlayer.GetGroupsForActiveJournalEntries]"
										item = {
											flowcontainer = {
												direction = vertical
												datamodel = "[JournalEntryGroup.GetActiveJournalEntryTypes(GetPlayer.Self)]"
												item = {
													flowcontainer = {
														direction = horizontal
														spacing = 8
														visible = "[EqualTo_string(JournalEntryType.GetName, Localize('sp_je_turanian_ideal'))]"
														datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
														button = {
															size = { 200 36 }
															using = default_button_action
															using = confirm_button_sound
															visible = "[JournalEntry.IsValid]"
															enabled = "[JournalEntry.IsValid]"
															onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
															onclick = "[GetVariableSystem.Clear('com_fullscreen')]"
															onclick = "[GetVariableSystem.Clear('com_open_window')]"
															tooltip = "sp_ct_btn_open_je_tt"
															textbox = {
																parentanchor = center
																text = "sp_ct_btn_open_je"
																autoresize = yes
																align = hcenter|nobaseline
																using = fontsize_small
															}
														}
														button = {
															size = { 140 36 }
															using = default_button_action
															using = check_button_sound
															visible = "[And(JournalEntry.IsValid, Not(JournalEntry.IsPinnedInOutliner))]"
															enabled = "[JournalEntry.IsValid]"
															onclick = "[JournalEntry.TogglePinInOutliner]"
															tooltip = "PIN_JOURNAL_ENTRY"
															textbox = {
																parentanchor = center
																text = "sp_ct_btn_pin_je"
																autoresize = yes
																align = hcenter|nobaseline
																using = fontsize_small
															}
														}
														button = {
															size = { 140 36 }
															using = default_button_action
															using = check_button_sound
															visible = "[And(JournalEntry.IsValid, JournalEntry.IsPinnedInOutliner)]"
															enabled = "[JournalEntry.IsValid]"
															onclick = "[JournalEntry.TogglePinInOutliner]"
															tooltip = "UNPIN_JOURNAL_ENTRY"
															textbox = {
																parentanchor = center
																text = "sp_ct_btn_unpin_je"
																autoresize = yes
																align = hcenter|nobaseline
																using = fontsize_small
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
