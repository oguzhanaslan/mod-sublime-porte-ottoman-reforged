# I-30 Campaign Tree — inspector components (Phase D1 + D2A + D2B + D2C).
# Scroll pattern: block_windows.gui default_block_window scrollarea (L525–569)
# + fullscreen_scrollarea expanding policies (L927–953).
# Reuses sp_ct_insp_req_row, sp_ct_insp_stat_row, sp_ct_insp_progress_card from 00_sp_ct_shared.gui.

types sp_ct_inspector_types {

	type sp_ct_insp_artwork_band = widget {
		size = { 100% 260 }
		minimumsize = { 480 260 }
		layoutpolicy_horizontal = expanding
		background = {
			using = dark_area
			alpha = 0.42
		}
		icon = {
			size = { 100% 260 }
			parentanchor = top|hcenter
			block "artwork_texture" {
				texture = "gfx/interface/icons/event_icons/event_default.dds"
			}
		}
		icon = {
			size = { 100% 100% }
			using = simple_frame
		}
	}

	type sp_ct_insp_status_header = widget {
		size = { 100% 34 }
		minimumsize = { 480 34 }
		layoutpolicy_horizontal = expanding

		textbox = {
			block "insp_title" { text = "sp_ct_node_placeholder" }
			parentanchor = left|vcenter
			autoresize = yes
			align = left|vcenter|nobaseline
			default_format = "#header"
			using = fontsize_medium
			max_width = 380
			elide = right
		}
		textbox = {
			block "insp_status_completed" { visible = no }
			parentanchor = right|vcenter
			text = "sp_ct_state_completed"
			autoresize = yes
			align = right|vcenter|nobaseline
			using = fontsize_small
			default_format = "#G"
		}
		textbox = {
			block "insp_status_active" { visible = no }
			parentanchor = right|vcenter
			text = "sp_ct_state_active"
			autoresize = yes
			align = right|vcenter|nobaseline
			using = fontsize_small
			default_format = "#Y"
		}
		textbox = {
			block "insp_status_available" { visible = no }
			parentanchor = right|vcenter
			text = "sp_ct_state_available"
			autoresize = yes
			align = right|vcenter|nobaseline
			using = fontsize_small
		}
		textbox = {
			block "insp_status_locked" { visible = no }
			parentanchor = right|vcenter
			text = "sp_ct_state_locked"
			autoresize = yes
			align = right|vcenter|nobaseline
			using = fontsize_small
			default_format = "#I"
		}
	}

	type sp_ct_insp_section_panel = widget {
		size = { 100% -1 }
		margin_bottom = 4

		background = {
			using = entry_bg_simple
		}
		background = {
			using = simple_frame
		}

		flowcontainer = {
			direction = vertical
			spacing = 0
			minimumsize = { 500 -1 }

			widget = {
				size = { 100% 26 }
				background = {
					using = default_header_bg_faded
				}
				textbox = {
					block "section_title" { text = "sp_ct_node_placeholder" }
					parentanchor = left|vcenter
					margin_left = 10
					autoresize = yes
					align = left|vcenter|nobaseline
					default_format = "#title"
					using = fontsize_small
				}
			}

			flowcontainer = {
				direction = vertical
				spacing = 1
				margin = { 8 10 }
				margin_bottom = 10
				block "section_body" {}
			}
		}
	}

	type sp_ct_insp_scroll_panel = scrollarea {
		layoutpolicy_vertical = expanding
		layoutpolicy_horizontal = expanding
		size = { 100% -1 }
		minimumsize = { 480 120 }
		scrollbarpolicy_horizontal = always_off
		scrollbarpolicy_vertical = as_needed

		scrollbar_vertical = {
			using = vertical_scrollbar
		}

		scrollwidget = {
			block "scroll_content" {
				flowcontainer = {
					direction = vertical
					spacing = 12
					minimumsize = { 480 -1 }
				}
			}
		}
	}

	# Phase D2A — Imperial Identity.
	type sp_ct_inspector_identity = widget {
		size = { 100% -1 }
		layoutpolicy_vertical = expanding
		layoutpolicy_horizontal = expanding
		minimumsize = { 500 -1 }

		vbox = {
			size = { 100% 100% }
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			spacing = 8

			sp_ct_insp_artwork_band = {
				blockoverride "artwork_texture" {
					texture = "gfx/interface/illustrations/sp_campaign_tree/sp_ct_insp_identity.dds"
				}
			}

			sp_ct_insp_status_header = {
				blockoverride "insp_title" { text = "sp_ct_node_identity" }
				blockoverride "insp_status_completed" { visible = "[GetScriptedGui('sp_ct_vis_identity_completed').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "insp_status_active" { visible = no }
				blockoverride "insp_status_available" { visible = "[GetScriptedGui('sp_ct_vis_identity_available').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "insp_status_locked" { visible = "[GetScriptedGui('sp_ct_vis_identity_locked').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
			}

			widget = {
				size = { 100% -1 }
				layoutpolicy_vertical = preferred
				layoutpolicy_horizontal = expanding
				minimumsize = { 480 -1 }
				flowcontainer = {
					direction = vertical
					spacing = 4
					textbox = {
						text = "sp_ct_sec_description"
						autoresize = yes
						align = left|nobaseline
						default_format = "#title"
						using = fontsize_small
					}
					textbox = {
						text = "sp_ct_insp_identity_desc"
						autoresize = yes
						align = left|nobaseline
						using = fontsize_small
						max_width = 500
						multiline = yes
					}
					textbox = {
						text = "sp_ct_sec_flavor"
						autoresize = yes
						align = left|nobaseline
						default_format = "#title"
						using = fontsize_small
						margin_top = 4
					}
					textbox = {
						text = "sp_ct_insp_identity_flavor"
						autoresize = yes
						align = left|nobaseline
						using = fontsize_small
						max_width = 500
						multiline = yes
					}
				}
			}

			sp_ct_insp_scroll_panel = {
				blockoverride "scroll_content" {
					flowcontainer = {
						direction = vertical
						spacing = 8
						minimumsize = { 500 -1 }

						sp_ct_insp_section_panel = {
							blockoverride "section_title" { text = "sp_ct_sec_unlock" }
							blockoverride "section_body" {
								sp_ct_insp_req_row = {
									blockoverride "req_met_icon" { visible = "[GetScriptedGui('sp_ct_vis_req_post_tanzimat_gate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
									blockoverride "req_fail_icon" { visible = "[Not(GetScriptedGui('sp_ct_vis_req_post_tanzimat_gate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
									blockoverride "req_label" { text = "sp_ct_req_post_tanzimat_gate" }
									blockoverride "req_tooltip" { tooltip = "sp_ct_req_post_tanzimat_gate_tt" }
								}
							}
						}

						sp_ct_insp_section_panel = {
							blockoverride "section_title" { text = "sp_ct_sec_completion" }
							blockoverride "section_body" {
								sp_ct_insp_req_row = {
									blockoverride "req_met_icon" { visible = "[GetScriptedGui('sp_ct_vis_req_identity_chosen').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
									blockoverride "req_fail_icon" { visible = "[Not(GetScriptedGui('sp_ct_vis_req_identity_chosen').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
									blockoverride "req_label" { text = "sp_ct_req_identity_chosen" }
									blockoverride "req_tooltip" { tooltip = "sp_ct_req_identity_chosen_tt" }
								}
							}
						}

						sp_ct_insp_section_panel = {
							blockoverride "section_title" { text = "sp_ct_sec_path" }
							blockoverride "section_body" {
								sp_ct_insp_req_row = {
									blockoverride "req_met_icon" { visible = "[GetScriptedGui('sp_ct_vis_req_ottomanism').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
									blockoverride "req_fail_icon" { visible = "[Not(GetScriptedGui('sp_ct_vis_req_ottomanism').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
									blockoverride "req_label" { text = "sp_ct_req_path_ottomanism" }
									blockoverride "req_tooltip" { tooltip = "sp_ct_req_path_ottomanism_tt" }
								}
								sp_ct_insp_req_row = {
									blockoverride "req_met_icon" { visible = "[GetScriptedGui('sp_ct_vis_req_islamism').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
									blockoverride "req_fail_icon" { visible = "[Not(GetScriptedGui('sp_ct_vis_req_islamism').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
									blockoverride "req_label" { text = "sp_ct_req_path_islamism" }
									blockoverride "req_tooltip" { tooltip = "sp_ct_req_path_islamism_tt" }
								}
								sp_ct_insp_req_row = {
									blockoverride "req_met_icon" { visible = "[GetScriptedGui('sp_ct_vis_req_turkism').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
									blockoverride "req_fail_icon" { visible = "[Not(GetScriptedGui('sp_ct_vis_req_turkism').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
									blockoverride "req_label" { text = "sp_ct_req_path_turkism" }
									blockoverride "req_tooltip" { tooltip = "sp_ct_req_path_turkism_tt" }
								}
							}
						}

						sp_ct_insp_section_panel = {
							blockoverride "section_title" { text = "sp_ct_sec_rewards" }
							blockoverride "section_body" {
								textbox = {
									text = "sp_ct_insp_identity_rewards"
									tooltip = "sp_ct_insp_identity_rewards_tt"
									autoresize = yes
									align = left|nobaseline
									using = fontsize_small
									max_width = 480
									multiline = yes
								}
							}
						}

						sp_ct_insp_section_panel = {
							blockoverride "section_title" { text = "sp_ct_sec_navigation" }
							blockoverride "section_body" {
								textbox = {
									text = "sp_ct_nav_prev_post_tanzimat"
									autoresize = yes
									align = left|nobaseline
									using = fontsize_small
									max_width = 480
									multiline = yes
								}
								textbox = {
									text = "sp_ct_nav_next_identity_paths"
									autoresize = yes
									align = left|nobaseline
									using = fontsize_small
									max_width = 480
									multiline = yes
								}
							}
						}
					}
				}
			}
		}
	}

	# Phase D2A — Ottomanism path hub.
	type sp_ct_inspector_ottomanism = widget {
		size = { 100% -1 }
		layoutpolicy_vertical = expanding
		layoutpolicy_horizontal = expanding
		minimumsize = { 500 -1 }

		vbox = {
			size = { 100% 100% }
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			spacing = 8

			sp_ct_insp_artwork_band = {
