							blockoverride "section_body" {
								textbox = {
									text = "sp_ct_insp_islamism_path"
									autoresize = yes
									align = left|nobaseline
									using = fontsize_small
									max_width = 480
									multiline = yes
								}
							}
						}

						sp_ct_insp_section_panel = {
							blockoverride "section_title" { text = "sp_ct_sec_rewards" }
							blockoverride "section_body" {
								textbox = {
									text = "sp_ct_insp_islamism_rewards"
