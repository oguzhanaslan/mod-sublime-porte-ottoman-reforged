								sp_ct_insp_req_row = {
									blockoverride "req_met_icon" { visible = "[GetScriptedGui('sp_ct_vis_req_turan_ideal_complete').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
									blockoverride "req_fail_icon" { visible = "[Not(GetScriptedGui('sp_ct_vis_req_turan_ideal_complete').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
