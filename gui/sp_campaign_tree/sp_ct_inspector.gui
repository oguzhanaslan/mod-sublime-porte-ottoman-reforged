				blockoverride "insp_status_completed" { visible = "[GetScriptedGui('sp_ct_vis_ottomanism_completed').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "insp_status_active" { visible = "[GetScriptedGui('sp_ct_vis_ottomanism_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "insp_status_available" { visible = "[GetScriptedGui('sp_ct_vis_ottomanism_available').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "insp_status_locked" { visible = "[GetScriptedGui('sp_ct_vis_ottomanism_locked').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
