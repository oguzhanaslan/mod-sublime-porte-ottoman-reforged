						minimumsize = { 500 -1 }

						sp_ct_insp_section_panel = {
							blockoverride "section_title" { text = "sp_ct_sec_unlock" }
							blockoverride "section_body" {
								sp_ct_insp_req_row = {
									blockoverride "req_met_icon" { visible = "[GetScriptedGui('sp_ct_vis_req_post_tanzimat_gate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
									blockoverride "req_fail_icon" { visible = "[Not(GetScriptedGui('sp_ct_vis_req_post_tanzimat_gate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
									blockoverride "req_label" { text = "sp_ct_req_post_tanzimat_gate" }
									blockoverride "req_tooltip" { tooltip = "sp_ct_req_post_tanzimat_gate_tt" }
								}
							}
						}

						sp_ct_insp_section_panel = {
							blockoverride "section_title" { text = "sp_ct_sec_completion" }
							blockoverride "section_body" {
								sp_ct_insp_req_row = {
									blockoverride "req_met_icon" { visible = "[GetScriptedGui('sp_ct_vis_req_ottomanism').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
									blockoverride "req_fail_icon" { visible = "[Not(GetScriptedGui('sp_ct_vis_req_ottomanism').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
									blockoverride "req_label" { text = "sp_ct_req_path_ottomanism" }
									blockoverride "req_tooltip" { tooltip = "sp_ct_req_path_ottomanism_tt" }
								}
							}
						}

						sp_ct_insp_section_panel = {
							blockoverride "section_title" { text = "sp_ct_sec_path" }
							blockoverride "section_body" {
								textbox = {
									text = "sp_ct_insp_ottomanism_path"
									autoresize = yes
