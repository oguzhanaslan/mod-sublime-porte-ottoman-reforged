	# Phase D2A — Islamism path hub.
	type sp_ct_inspector_islamism = widget {
		size = { 100% -1 }
		layoutpolicy_vertical = expanding
		minimumsize = { 500 -1 }

		vbox = {
			size = { 100% 100% }
			layoutpolicy_vertical = expanding
			spacing = 8

			sp_ct_insp_artwork_band = {
				blockoverride "artwork_texture" {
					texture = "gfx/interface/illustrations/sp_campaign_tree/sp_ct_insp_islamism.dds"
