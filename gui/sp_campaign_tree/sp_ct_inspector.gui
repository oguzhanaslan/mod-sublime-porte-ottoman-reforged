	# Phase D2B — shared Ottomanism stage / capstone shell.
	type sp_ct_inspector_ottomanism_stage = widget {
		size = { 100% -1 }
		layoutpolicy_vertical = expanding
		minimumsize = { 500 -1 }

		vbox = {
			size = { 100% 100% }
			layoutpolicy_vertical = expanding
			spacing = 8

			sp_ct_insp_artwork_band = {
				blockoverride "artwork_texture" {
					texture = "gfx/interface/illustrations/sp_campaign_tree/sp_ct_insp_ottomanism.dds"
				}
			}

			sp_ct_insp_status_header = {
				block "insp_title" { text = "sp_ct_node_placeholder" }
				block "insp_status_completed" { visible = no }
				block "insp_status_active" { visible = no }
				block "insp_status_available" { visible = no }
				block "insp_status_locked" { visible = no }
			}

			widget = {
				flowcontainer = {
					direction = vertical
					spacing = 4
					textbox = {
						text = "sp_ct_sec_description"
						autoresize = yes
						align = left|nobaseline
						default_format = "#title"
						using = fontsize_small
					}
					textbox = {
						block "stage_desc" { text = "sp_ct_node_placeholder" }
						autoresize = yes
						align = left|nobaseline
						using = fontsize_small
						max_width = 500
						multiline = yes
					}
					textbox = {
						text = "sp_ct_sec_flavor"
						autoresize = yes
						align = left|nobaseline
						default_format = "#title"
						using = fontsize_small
						margin_top = 4
					}
					textbox = {
						block "stage_flavor" { text = "sp_ct_node_placeholder" }
						autoresize = yes
						align = left|nobaseline
						using = fontsize_small
						max_width = 500
						multiline = yes
					}
				}
			}

			sp_ct_insp_scroll_panel = {
				blockoverride "scroll_content" {
					flowcontainer = {
						direction = vertical
						spacing = 8
						minimumsize = { 500 -1 }
						block "stage_scroll_body" {}
					}
				}
			}
		}
	}

	type sp_ct_inspector_ottomanism_s1 = widget {
		size = { 100% -1 }
		layoutpolicy_vertical = expanding
		sp_ct_inspector_ottomanism_stage = {
			blockoverride "insp_title" { text = "sp_ct_node_ottomanism_s1" }
			blockoverride "insp_status_completed" { visible = "[GetScriptedGui('sp_ct_vis_ottomanism_s1_completed').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
			blockoverride "insp_status_active" { visible = "[GetScriptedGui('sp_ct_vis_ottomanism_s1_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
			blockoverride "insp_status_available" { visible = no }
			blockoverride "insp_status_locked" { visible = "[GetScriptedGui('sp_ct_vis_ottomanism_s1_locked').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
			blockoverride "stage_desc" { text = "sp_ct_insp_ottomanism_s1_desc" }
			blockoverride "stage_flavor" { text = "sp_ct_insp_ottomanism_s1_flavor" }
			blockoverride "stage_scroll_body" {
				sp_ct_insp_section_panel = {
