				widget = {
					size = { 33% 100% }
					layoutpolicy_vertical = expanding
					background = {
						using = dark_area
						alpha = 0.42
						margin = { 2 2 }
					}

					vbox = {
						size = { 100% 100% }
						margin = { 10 10 }
						spacing = 6

						scrollarea = {
							layoutpolicy_vertical = expanding
							layoutpolicy_horizontal = expanding
							scrollbar_vertical = { using = vertical_scrollbar }

							scrollwidget = {
								flowcontainer = {
									direction = vertical
									spacing = 4
									minimumsize = { 500 -1 }

									sp_ct_insp_empty = {
