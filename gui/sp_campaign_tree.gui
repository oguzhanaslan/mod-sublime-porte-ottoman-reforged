								}
								blockoverride "node_icon" {
									texture = "gfx/interface/illustrations/sp_campaign_tree/sp_ct_insp_post_tanzimat.dds"
								}
							}
							sp_ct_connector_trunk_v = {}
							sp_ct_node_artwork = {
								blockoverride "node_onclick" {
									onclick = "[GetScriptedGui('sp_ct_select_identity').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								blockoverride "node_title" { text = "sp_ct_node_identity" }
