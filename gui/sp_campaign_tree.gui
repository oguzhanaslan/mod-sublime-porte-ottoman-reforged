	type sp_ct_insp_empty = flowcontainer {
		direction = vertical
		parentanchor = center
		spacing = 12
		widget = {
			size = { 520 260 }
			parentanchor = hcenter
			background = {
				using = dark_area
				alpha = 0.5
			}
			icon = {
				parentanchor = center
				size = { 520 260 }
				texture = "gfx/interface/illustrations/sp_campaign_tree/sp_ct_insp_empty.dds"
			}
			icon = {
				size = { 100% 100% }
				using = simple_frame
			}
		}
		textbox = {
			text = "sp_ct_insp_empty_title"
			autoresize = yes
			align = hcenter|nobaseline
			default_format = "#title"
			using = fontsize_xl
		}
		textbox = {
			text = "sp_ct_insp_empty_desc"
			autoresize = yes
			align = hcenter|nobaseline
			using = fontsize_medium
			max_width = 500
			multiline = yes
		}
	}
}
