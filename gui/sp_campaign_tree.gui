									max_width = 480
									multiline = yes
								}
							}
							textbox = {
								text = "sp_ct_sec_rewards"
								autoresize = yes
								align = left|nobaseline
								default_format = "#header"
								using = fontsize_medium
								margin_top = 6
							}
							textbox = {
								text = "sp_ct_insp_great_ottoman_rewards"
								tooltip = "sp_ct_insp_great_ottoman_rewards_tt"
								autoresize = yes
								align = left|nobaseline
								using = fontsize_small
								max_width = 500
								multiline = yes
							}
							textbox = {
								text = "sp_ct_sec_navigation"
								autoresize = yes
								align = left|nobaseline
								default_format = "#header"
								using = fontsize_medium
								margin_top = 6
							}
							textbox = {
								text = "sp_ct_nav_prev_turan_s4"
								autoresize = yes
								align = left|nobaseline
								using = fontsize_small
								max_width = 500
								multiline = yes
							}
							textbox = {
								text = "sp_ct_nav_next_none"
								autoresize = yes
								align = left|nobaseline
								using = fontsize_small
								max_width = 500
								multiline = yes
							}
							flowcontainer = {
								direction = vertical
								visible = "[GetScriptedGui('sp_ct_vis_req_je_turan').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								spacing = 4
								margin_top = 8
								flowcontainer = {
									direction = vertical
									datamodel = "[AccessPlayer.GetGroupsForActiveJournalEntries]"
									item = {
										flowcontainer = {
											direction = vertical
											datamodel = "[JournalEntryGroup.GetActiveJournalEntryTypes(GetPlayer.Self)]"
											item = {
												flowcontainer = {
													direction = horizontal
													spacing = 8
													visible = "[EqualTo_string(JournalEntryType.GetName, Localize('sp_je_turanian_ideal'))]"
													datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
													button = {
														size = { 200 36 }
														using = default_button_action
														using = confirm_button_sound
														visible = "[JournalEntry.IsValid]"
														enabled = "[JournalEntry.IsValid]"
														onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
														onclick = "[GetVariableSystem.Clear('com_fullscreen')]"
														onclick = "[GetVariableSystem.Clear('com_open_window')]"
														tooltip = "sp_ct_btn_open_je_tt"
														textbox = {
															parentanchor = center
															text = "sp_ct_btn_open_je"
															autoresize = yes
															align = hcenter|nobaseline
															using = fontsize_small
														}
													}
													button = {
														size = { 140 36 }
														using = default_button_action
														using = check_button_sound
														visible = "[And(JournalEntry.IsValid, Not(JournalEntry.IsPinnedInOutliner))]"
														enabled = "[JournalEntry.IsValid]"
														onclick = "[JournalEntry.TogglePinInOutliner]"
														tooltip = "PIN_JOURNAL_ENTRY"
														textbox = {
															parentanchor = center
															text = "sp_ct_btn_pin_je"
															autoresize = yes
															align = hcenter|nobaseline
															using = fontsize_small
														}
													}
													button = {
														size = { 140 36 }
														using = default_button_action
														using = check_button_sound
														visible = "[And(JournalEntry.IsValid, JournalEntry.IsPinnedInOutliner)]"
														enabled = "[JournalEntry.IsValid]"
														onclick = "[JournalEntry.TogglePinInOutliner]"
														tooltip = "UNPIN_JOURNAL_ENTRY"
														textbox = {
															parentanchor = center
															text = "sp_ct_btn_unpin_je"
															autoresize = yes
															align = hcenter|nobaseline
															using = fontsize_small
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}

					### SP_CT_INSPECTOR_PANELS_END
								}
							}
						}
					}
				}
			}
		}
	}

