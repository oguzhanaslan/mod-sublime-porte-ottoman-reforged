# I-30 Campaign Tree UI ? visual overhaul (presentation only).
# Additive scripted widget. No vanilla GUI overwrite.
# Custom near-fullscreen chrome (not InformationPanelBar) so com_open_window /
# com_fullscreen clear reliably on close/back.
# Node classes: sp_ct_node_artwork / sp_ct_node_compact (componentized).
# Connectors are GUI widgets (vanilla techtree_spline is CPP-backed and unavailable).
# Shared primitives: gui/sp_campaign_tree/00_sp_ct_shared.gui
# Node components: gui/sp_campaign_tree/sp_ct_nodes.gui
# Header: gui/sp_campaign_tree/sp_ct_header.gui
# Inspector: gui/sp_campaign_tree/sp_ct_inspector.gui

widget = {
	name = "sp_campaign_tree_root"
	layer = layer_ingame_menu
	size = { 100% 100% }
	visible = "[GetMetaPlayer.GetPlayedOrObservedCountry.IsValid]"

	# fullscreen_top_header inside sp_campaign_tree_window clears vanilla top HUD;
	# no outer margin_top offset (that strip was redundant dead space).
	sp_campaign_tree_window = {}
}

types sp_campaign_tree_types {

	type sp_campaign_tree_window = widget {
		name = "sp_campaign_tree_window"
		datacontext = "[AccessPlayer]"
		size = { 100% 100% }
		using = clickthrough_blocker

		visible = "[GetVariableSystem.HasValue('com_open_window', 'gui_sidebar_sp_campaign_tree')]"
		alpha = 0

		state = {
			name = _show
			trigger_on_create = yes
			alpha = 1
			duration = 0
			on_start = "[InformationPanelBar.ClosePanel]"
			on_start = "[MapListPanelManager.CloseCurrentPanel]"
			on_finish = "[GetVariableSystem.Set('com_fullscreen', 'com_fullscreen')]"
			start_sound = {
				soundeffect = "event:/SFX/UI/SideBar/journal"
			}
		}
		state = {
			name = _hide
			alpha = 0
			duration = 0.2
			using = Animation_Curve_Default
			on_finish = "[GetVariableSystem.Clear('com_fullscreen')]"
			start_sound = {
				soundeffect = "event:/SFX/UI/SideBar/journal_stop"
			}
		}

		background = {
			using = default_bg
			margin = { 16 16 }
		}

		fullscreen_top_header = {}

		widget = {
			size = { 50 100% }
			parentanchor = left
			background = {
				using = dark_area
				alpha = 0.5
				mirror = horizontal
				modify_texture = {
					texture = "gfx/interface/masks/fade_horizontal_left_full.dds"
					spriteType = Corneredstretched
					spriteborder = { 0 0 }
					blend_mode = alphamultiply
				}
			}
		}
		widget = {
			size = { 50 100% }
			parentanchor = right
			background = {
				using = dark_area
				alpha = 0.5
				modify_texture = {
					texture = "gfx/interface/masks/fade_horizontal_left_full.dds"
					spriteType = Corneredstretched
					spriteborder = { 0 0 }
					blend_mode = alphamultiply
				}
			}
		}

		vbox = {
			using = clickthrough_blocker
			margin_top = 100
			margin_left = 16
			margin_right = 16
			margin_bottom = 16
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			spacing = 12

			sp_ct_campaign_header = {
				blockoverride "header_back_button" {
					back_button_large = {
						position = { 11 15 }
						parentanchor = top|left
						onclick = "[GetVariableSystem.Clear('com_open_window')]"
						onclick = "[GetVariableSystem.Clear('com_fullscreen')]"
						input_action = "back"
					}
				}
				blockoverride "header_close_button" {
					close_button_large = {
						parentanchor = top|right
						position = { -11 15 }
						onclick = "[GetVariableSystem.Clear('com_open_window')]"
						onclick = "[GetVariableSystem.Clear('com_fullscreen')]"
						shortcut = "close_window"
					}
				}
			}

			hbox = {
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding
				spacing = 12

				scrollarea = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					size = { -1 100% }
					scrollbarpolicy_horizontal = as_needed
					scrollbar_horizontal = { using = horizontal_scrollbar }
					scrollbar_vertical = { using = vertical_scrollbar }

					scrollwidget = {

						flowcontainer = {
							direction = vertical
							parentanchor = top|hcenter
							spacing = 8
							margin_bottom = 12
							minimumsize = { 992 -1 }

							sp_ct_node_artwork = {
								blockoverride "node_onclick" {
									onclick = "[GetScriptedGui('sp_ct_select_tanzimat').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								blockoverride "node_title" { text = "sp_ct_node_tanzimat" }
								blockoverride "node_tooltip" { tooltip = "sp_ct_tt_tanzimat" }
								blockoverride "node_selected" {
									visible = "[GetScriptedGui('sp_ct_vis_sel_tanzimat').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								blockoverride "state_completed" {
									visible = "[GetScriptedGui('sp_ct_vis_tanzimat_completed').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								blockoverride "state_active" {
									visible = "[GetScriptedGui('sp_ct_vis_tanzimat_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								blockoverride "state_active_glow" {
									visible = "[GetScriptedGui('sp_ct_vis_tanzimat_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								blockoverride "state_available" {
									visible = "[GetScriptedGui('sp_ct_vis_tanzimat_available').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								blockoverride "state_locked" {
									visible = "[GetScriptedGui('sp_ct_vis_tanzimat_locked').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								blockoverride "state_locked_dim" {
									visible = "[GetScriptedGui('sp_ct_vis_tanzimat_locked').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								blockoverride "node_icon" {
									texture = "gfx/interface/illustrations/sp_campaign_tree/sp_ct_insp_tanzimat.dds"
								}
							}
							sp_ct_connector_trunk_v = {}
							sp_ct_node_artwork = {
								blockoverride "node_onclick" {
									onclick = "[GetScriptedGui('sp_ct_select_post_tanzimat').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								blockoverride "node_title" { text = "sp_ct_node_post_tanzimat" }
